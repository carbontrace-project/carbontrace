# ---- Database (Amazon RDS PostgreSQL 16) ----
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/carbontrace
DB_USERNAME=postgres
DB_PASSWORD=<your-rds-password>

# ---- JWT (self-generated) ----
JWT_SECRET=myDefaultSecretKeyThatIsAtLeast256BitsLongForHS256Algorithm
JWT_EXPIRATION=86400000
REFRESH_TOKEN_EXPIRATION=604800000

# ---- AWS (S3 only — used by Spring Boot) ----
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
AWS_REGION=ap-south-1
S3_BUCKET=carbontrace-docs-<yourname>

# ---- Gmail SMTP (OTP emails) ----
MAIL_USERNAME=youraddress@gmail.com
MAIL_APP_PASSWORD=<16-char-app-password>

# ---- Gemini (FastAPI only — Track C needs this from day one) ----
GEMINI_API_KEY=<your-gemini-key>

# ---- Internal Service URLs ----
FASTAPI_URL=http://localhost:8000
SPRING_BOOT_URL=http://localhost:8080
