# Lombok configuration for the CarbonTrace backend.
#
# Section 21 mandates constructor injection via @RequiredArgsConstructor and
# forbids field @Autowired. That combination has one sharp edge: Lombok does NOT
# copy Spring's @Qualifier from a field onto the constructor parameter it
# generates, so a @Qualifier written on a final field is silently DECORATIVE and
# Spring falls back to matching the parameter name against bean names.
#
# That fallback happens to work, which is what makes it dangerous: the wiring is
# correct until someone renames a field, and then it breaks at startup with a
# NoUniqueBeanDefinitionException that points at neither the rename nor the
# annotation. Copying the annotation makes the @Qualifier authoritative, as it
# reads.
#
# Needed from STEP A021, where AppConfig began providing two RestTemplate beans
# with the different per-flow timeouts of Section 18.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
